[Desktop Entry]
Type=Application
Name=Install ARCHIVEFLIX
Comment=Install ARCHIVEFLIX on this computer (no terminal needed)
Exec=python3 -c "import os,subprocess,sys,time; p=sys.argv[1] if len(sys.argv)>1 else ''; p=p[7:] if p.startswith('file://') else p; ds=([os.path.dirname(p)] if p else [])+[os.getcwd()]; d=next((x for x in ds if os.path.isfile(os.path.join(x, 'install.sh'))), ''); subprocess.call(['bash', os.path.join(d, 'install.sh')]) if d else print('ARCHIVEFLIX installer not found. Open a terminal in the ARCHIVEFLIX folder and run: bash install.sh'); time.sleep(15) if not d else None; sys.exit(1) if not d else None" %k
Icon=system-software-install
Terminal=true
Categories=Utility;
